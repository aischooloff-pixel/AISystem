# Образец конфигурации (ТЗ, Часть 5). Скопируйте в .env и заполните секреты.
# .env в git не попадает (.gitignore).

# ── Telegram ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Telegram ID Юлии — сюда идут карточки клиентов и уведомления
TELEGRAM_ADMIN_ID=
# ID канала (форма -100XXXXXXXXXX)
TELEGRAM_CHANNEL_ID=
# ID linked discussion group для комментариев (форма -100XXXXXXXXXX)
TELEGRAM_DISCUSSION_GROUP_ID=
# Публичный базовый URL сервера без пути, например https://bot.example.com
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
# Секрет вебхука (опционально): Telegram шлёт его в заголовке апдейтов,
# чужие POST отбрасываются. Пусто — выводится автоматически из токена бота.
WEBHOOK_SECRET=
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# ── OpenAI ────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30
OPENAI_MAX_RETRIES=2

# ── Airtable ──────────────────────────────────────────────
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_CONTACTS_TABLE=Contacts
AIRTABLE_TOUCHES_TABLE=Touches
AIRTABLE_COMMENTS_TABLE=Comments
AIRTABLE_POSTS_TABLE=Posts
AIRTABLE_TASKS_TABLE=Tasks
# Блок 11 (анкета «Точка сбоя») — включён в Спринт 1
AIRTABLE_DIAGNOSTICS_TABLE=Diagnostics

# ── Логика ────────────────────────────────────────────────
# Порог уверенности AI («Критерии квалификации», п. 9): ниже — решение принимает Юлия
AI_CONFIDENCE_THRESHOLD=85
TIMEOUT_REMINDER_HOURS=24
TIMEOUT_COLD_HOURS=72
NURTURING_REVIEW_DAYS=7

# ── Прочее ────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
KNOWLEDGE_DIR=bot/knowledge
TIMEZONE=Europe/Moscow
